{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": [
			"DOM", "ES6"
		],
		"module": "ES6",
		/* Enabled for React */
		"jsx": "react-jsx",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"rootDir": "./src"
	},
	"include": [
		"src/webview",
		"src/webviewProtocol"
	]
}
